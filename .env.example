# Copy to .env and fill in real values. Never commit .env.

# --- Core ---------------------------------------------------------------
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-to-a-long-random-string
DB_PATH=var/tickets.db

# Seeded on first start only. Changing these later does not change the account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-8-chars

# 12 hours. Cookies are always HttpOnly + SameSite=Lax.
SESSION_MAX_AGE=43200
# Set to true once the app is served over HTTPS.
COOKIE_SECURE=false

# Login throttle: N failed attempts per IP per window.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# Only enable behind a reverse proxy you control (reads X-Forwarded-For).
TRUST_PROXY=false

# --- Event --------------------------------------------------------------
EVENT_NAME=School Party 2026
EVENT_DATE=Sat 12 Dec 2026, 7:00 PM
EVENT_DATETIME=2026-12-12T19:00:00+05:30
EVENT_VENUE=School Main Hall
EVENT_TIMEZONE=Asia/Colombo
CURRENCY=LKR
BASE_URL=http://localhost:8000

# --- Email --------------------------------------------------------------
# console = write .eml files to var/outbox/ (no real mail, safe for dev)
# smtp    = send through SMTP_HOST
MAIL_MODE=console

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USER=bot@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_NAME=School Party Tickets
SMTP_FROM_EMAIL=bot@example.com
